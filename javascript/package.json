{
  "name": "@aquariusdefi/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the Aquarius protocol on Stellar",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.0"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AquariusDeFi/aquarius-sdk.git",
    "directory": "javascript"
  },
  "homepage": "https://docs.aqua.network/developers/quickstart",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.0.0"
  },
  "engines": {
    "node": ">=18"
  }
